# Geheimer Zugangsschlüssel für den Admin-Bereich.
# Wähle eine lange, zufällige Zeichenfolge (z.B. mit einem Passwort-Generator).
# Der Admin-Bereich ist danach erreichbar unter: https://deine-domain.de/admin/DEIN-TOKEN
ADMIN_TOKEN=aendere-mich-zu-einem-langen-zufallscode

# Wird automatisch gesetzt, sobald du in Vercel unter "Storage" eine
# Upstash-Redis-Datenbank mit diesem Projekt verbindest. Ohne diese Variablen
# läuft der Shop mit Beispieldaten, aber Änderungen im Admin-Bereich werden
# nicht dauerhaft gespeichert (siehe README.md, Abschnitt "Datenbank einrichten").
KV_REST_API_URL=
KV_REST_API_TOKEN=
