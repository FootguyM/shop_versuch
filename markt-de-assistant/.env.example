# ---------------------------------------------------------------------------
# Kopiere diese Datei nach ".env" und trage deine echten Werte ein.
# ".env" ist per .gitignore ausgeschlossen und darf NIE committet werden.
# ---------------------------------------------------------------------------

# --- markt.de Zugangsdaten -------------------------------------------------
MARKT_USERNAME=deine@email.de
MARKT_PASSWORD=dein-passwort

# --- Telegram --------------------------------------------------------------
# Token von @BotFather. Wenn der Token jemals in einem Chat, Screenshot oder
# Commit gelandet ist: bei @BotFather mit /revoke neu erzeugen.
TELEGRAM_BOT_TOKEN=
# Nur diese Chat-ID darf den Bot steuern. Alles andere wird abgewiesen.
TELEGRAM_CHAT_ID=

# --- Residential Proxy (optional) ------------------------------------------
# Leer lassen, wenn der Rechner ohnehin schon an einem deutschen
# Privatanschluss haengt (Raspberry Pi zuhause = genau dieser Fall).
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Hugging Face (optional) -----------------------------------------------
# Wird fuer den Standard-Backend "llama_cpp" NICHT gebraucht - oeffentliche
# GGUF-Modelle laedt der Bot ohne Token. Nur setzen, wenn du das Backend
# "hf_inference" oder ein gated Modell nutzen willst.
HUGGINGFACE_TOKEN=

# --- Web-UI ----------------------------------------------------------------
# Passwort fuer das lokale Dashboard. Leer = kein Login (nur bei 127.0.0.1 ok).
UI_PASSWORD=
