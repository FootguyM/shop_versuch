# Konfiguration des Telegram-Bots.
#
# Diese Datei nach "bot.env" kopieren und ausfuellen:
#     cp bot.env.example bot.env
#     chmod 600 bot.env
# Sie enthaelt Zugangsdaten und gehoert deshalb NICHT ins Repository
# (in .gitignore bereits ausgenommen).

# --- Pflicht ---------------------------------------------------------------

# Token deines Bots von @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# sessionid-Cookie des Instagram-Kontos, mit dem gelesen wird.
IG_SESSIONID=

# --- Zugriff ---------------------------------------------------------------

# Telegram-Benutzername, der den Bot bedienen darf (ohne @).
TELEGRAM_ALLOWED_USERNAME=vvalora

# Nur noetig, wenn dein Telegram-Konto keinen Benutzernamen hat:
# numerische Chat-ID (bekommst du von @userinfobot).
#TELEGRAM_CHAT_ID=

# --- Tempo (die Vorgaben sind bewusst gemaechlich) --------------------------

# Pause zwischen zwei Seitenabrufen in Millisekunden.
#BOT_DELAY_MS=12000
# Profile je Abruf (hoechstens 100).
#BOT_PAGE_SIZE=50
# Nach so vielen geprueften Profilen: Treffer melden und laenger pausieren.
#BOT_STAGE_SIZE=500
# Laenge dieser Pause in Sekunden.
#BOT_ETAPPE_PAUSE_SECONDS=120
# Wartezeit nach einem Fehler, in Sekunden.
#BOT_ERROR_PAUSE_SECONDS=120

# --- Ablage ----------------------------------------------------------------

# Wo der Zwischenstand liegt (Pfad relativ zum Arbeitsverzeichnis).
#BOT_STATE_FILE=.botstate/state.json
# So viele Treffer stehen am Ende direkt im Chat, der Rest nur in der CSV.
#BOT_MAX_LIST=500
